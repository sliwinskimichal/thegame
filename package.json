{
  "name": "underhearth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Underhearth - krasnoludzka kolonia w przekroju 2.5D. Kop w głąb, buduj gród, stawiaj czoła potworom.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "node scripts/content-check.mjs",
    "style:report": "python3 scripts/style-report.py",
    "tools:smoke": "node scripts/tools-smoke.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "postprocessing": "6.39.6",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
